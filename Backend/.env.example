# Copy this file to `.env` (in Backend/) and fill in real values for local
# development. `.env` is gitignored — never commit real secrets.
#
# In CI, staging, and production these are set directly as real environment
# variables by the platform running the service (see the "Secrets
# management" section in README.md); no `.env` file is present there.
#
# Every variable below is read by the `config` crate (see config/src/lib.rs)
# via `Settings::load()`. Variables with no default are required — the
# service refuses to start without them.
#
# The values below assume you're running the binaries directly on the host
# (`cargo run -p api`). Under `docker compose up`, this file is still the
# source for secrets, but the compose file overrides the three variables
# marked "compose overrides this" so the API container reaches the `postgres`
# and `stellar` services instead of your host's localhost.

# --- Database ---------------------------------------------------------------

# PostgreSQL connection string. Required. (compose overrides this)
DATABASE_URL=postgres://locka:locka@localhost:5432/locka

# --- Stellar / Soroban -------------------------------------------------------

# Soroban RPC endpoint. Required. (compose overrides this, pointing it at the
# local quickstart network at http://stellar:8000/rpc)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase the service operates against. Required. Not secret, but
# must match the network SOROBAN_RPC_URL points at. (compose overrides this
# with the standalone-network passphrase, "Standalone Network ; February 2017")
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Encrypted object storage (off-chain records) ---------------------------

# S3-compatible endpoint. Required.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

# Bucket used for encrypted off-chain record storage. Required.
OBJECT_STORAGE_BUCKET=locka-records

# Secret. Required.
OBJECT_STORAGE_ACCESS_KEY_ID=changeme

# Secret. Required.
OBJECT_STORAGE_SECRET_ACCESS_KEY=changeme

# --- Auth ---------------------------------------------------------------------

# Signing key for issued session JWTs (SEP-10 auth flow, see issue #12).
# Secret. Required.
JWT_SIGNING_KEY=changeme

# --- Service ------------------------------------------------------------------

# Address the `api` HTTP server binds to. Optional, defaults to 0.0.0.0:8080.
#API_BIND_ADDR=0.0.0.0:8080

# How often the `worker` polls for new work, in seconds. Optional, defaults to 30.
#WORKER_TICK_INTERVAL_SECS=30

# --- Logging (read directly by the `telemetry` crate, not `config`) -----------

# Log level filter, standard `tracing`/`env_logger` syntax. Optional, defaults to "info".
#RUST_LOG=info

# Log output format: "json" for structured production logs, anything else
# (or unset) for human-readable local development output. Optional.
#LOG_FORMAT=pretty

# --- Docker Compose (read by `docker compose`, not by the service) ------------

# Host ports the compose stack publishes. Only the host side of the mapping
# changes, so the services still reach each other on their standard ports.
# Set these if something else on your machine already owns a port — a
# system-wide PostgreSQL on 5432 is the usual culprit.
#POSTGRES_PORT=5432
#STELLAR_PORT=8000
#API_PORT=8080
